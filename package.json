{
  "name": "finance-offline",
  "version": "9.0.0",
  "private": true,
  "description": "Offline-first bilingual personal finance app",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "vite": "^5.4.0"
  }
}
